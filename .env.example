# Copy to .env - auto-loaded.
# `browser-harness --bootstrap` creates this file for you if missing.

# Delegate agent provider. GLM Coding Plan default.
# Required: paste your GLM Coding Plan API key (or any OpenAI-compatible key) below.
BH_AGENT_API_KEY=your_api_key_here

# Optional overrides — defaults match the GLM Coding Plan.
# For pay-as-you-go PaaS use https://api.z.ai/api/paas/v4/ instead.
BH_AGENT_MODEL=glm-5.1
BH_AGENT_BASE_URL=https://api.z.ai/api/coding/paas/v4/
BH_AGENT_POLICY=autonomous

# Optional: only set if you use Browser Use cloud browsers / profile sync.
# Leave unset for local Chrome usage.
# BROWSER_USE_API_KEY=bu_your_key_here
