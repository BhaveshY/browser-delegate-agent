# Copy to .env - auto-loaded.

# Optional: remote Browser Use cloud browsers / profile sync.
BROWSER_USE_API_KEY=bu_your_key_here

# Optional: delegate agent provider. Z.AI GLM-5.1 is the default.
BH_AGENT_API_KEY=your_openai_compatible_key_here
BH_AGENT_MODEL=glm-5.1
BH_AGENT_BASE_URL=https://api.z.ai/api/paas/v4/
BH_AGENT_POLICY=autonomous
